{
  "name": "webapp",
  "version": "2.0.2",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:sso": "next dev --turbopack --experimental-https --hostname local.monashcoding.com",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "node --test 'lib/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "warm:pages": "node scripts/warm-pages.ts",
    "verify:resolver": "tsx scripts/verify-resolver.mts",
    "verify:corpus": "tsx scripts/verify-corpus.mts",
    "verify:transitions": "tsx scripts/verify-transitions.mts",
    "refresh:stats": "tsx scripts/refresh-stats.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dagrejs/dagre": "^3.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@monmap/db": "workspace:*",
    "@next/third-parties": "^16.4.5",
    "@xyflow/react": "^12.12.1",
    "better-auth": "^1.7.18",
    "boring-avatars": "2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "0.45.4",
    "jose": "^6.2.15",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "posthog-js": "^1.447.1",
    "posthog-node": "^5.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3"
  }
}
