{
  "extends": "@monashcoding/tsconfig/nextjs.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    // The preset turns this on. 162 index reads here do not handle
    // undefined yet, so it stays off until they do.
    "noUncheckedIndexedAccess": false,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "oxlint.config.ts"]
}
